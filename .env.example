# Скопируйте в .env и заполните своими значениями.
# .env не коммитится (см. .gitignore).

# API-ключ Яндекс Карт для JavaScript API 2.1.
# Используется обоими приложениями (sender и receiver).
YANDEX_MAPS_API_KEY=

# --- Безопасность ---
# По умолчанию оба сервиса слушают только 127.0.0.1 и не требуют токен.
# Для доступа из сети (например, с телефона) задайте HOST=0.0.0.0
# и обязательно заполните соответствующий токен — иначе сервис не запустится.
# Вход в UI с токеном: http://localhost:4000/?token=<RECEIVER_TOKEN>

# RECEIVER_HOST=127.0.0.1
# SENDER_HOST=127.0.0.1

# Токен приёмника. Мобильное приложение отправляет его как
# Authorization: Bearer <token>. Обязателен при RECEIVER_HOST != 127.0.0.1.
RECEIVER_TOKEN=

# Токен sender. Обязателен при SENDER_HOST != 127.0.0.1.
SENDER_TOKEN=

# Куда sender может отправлять preview-точки (через запятую).
# Другие хосты будут отклонены, чтобы токен не утёк на чужой сервер.
PREVIEW_ALLOWED_HOSTS=127.0.0.1,localhost,::1,10.0.2.2

# Хранить IP, User-Agent и raw-тело запроса. По умолчанию выключено.
# STORE_DEBUG_META=1

# Сколько дней хранить историю позиций. 0 — хранить бессрочно.
POSITIONS_RETENTION_DAYS=30

# --- iOS logs (порт 8899) ---
# Live-просмотр файла Documents/courier_tracking.log из iOS Simulator.
# Сервер слушает только loopback.
IOS_LOGS_PORT=8899
IOS_APP_BUNDLE_ID=com.whitetigersoft.ru.fabric.bo
IOS_LOG_FILENAME=courier_tracking.log
